display_column_a               = indent "displayColumn" (required_ws component_id)? ws "(" line_end display_column_a_body_line* indent ")" line_end
display_column_a_body_line     = display_column_a_direct_property_line
                       / display_column_a_group_block
                       / blank_lines

display_column_a_direct_property_line     = indent display_column_a_direct_property line_end 
display_column_a_direct_property          = "sequence" ":" ws number

display_column_a_group_block              = display_column_a_identification

display_column_a_identification                      = indent "identification" ws "{" line_end display_column_a_identification_property_line* indent "}" line_end
display_column_a_identification_property_line        = indent display_column_a_identification_property line_end
display_column_a_identification_property             = "column" ":" ws string_like_value