reference                       = "@" reference_character*
variable                        = "&" reference_character "."
component_id                    = number / identifier / string
code_block                      = nl? ws multiline_string
                                / string_like_value
multiline_string                = "```" ( any_character / nl )* "```"
blank_lines                     = (ws nl)*
ws                              = ~r"[ \t]*"
required_ws                     = ~r"[ \t]+"
line_end                        = nl
nl                              = "\n" / "\r\n"
indent                          = ~r"[ \t]*"
value                           = multiline_string / array / complex / boolean / number / reference / variable / string / identifier
array                           = array_of_value
array_separator                 = required_ws / line_end indent
array_of_value                  = "[" ( ws value ( array_separator value )* ws / line_end ( indent value line_end )? indent )? "]"
array_of_string_like_value      = "[" (line_end indent string_like_value)+ line_end indent "]"
one_or_more_string_like_values  = array_of_string_like_value / string_like_value
complex                         = "{" line_end key_value_line* indent "}"
key_value_line                  = indent key_value line_end
key_value                       = identifier ":" ws value
string_like_value               = ~r"[^\[\]\n\r]+"
reference_character             = ~r"[A-Za-z0-9_/#-]*"
string                          = ~r"\"[^\"]+\""
any_character                   = ~r"[^`\n\r]"
number                          = "-"? digit+  ( "." digit+ )?
digit                           = ~r"[0-9]"
identifier                      = identifier_start identifier_rest*
identifier_start                = ~r"[A-Za-z0-9_]"
identifier_rest                 = identifier_start / "." / "-"
boolean                         = "true" / "false"
