sort_a               = indent "sort" (required_ws component_id)? ws "(" line_end sort_a_body_line* indent ")" line_end
sort_a_body_line     = sort_a_direct_property_line
                       / sort_a_group_block
                       / blank_lines

sort_a_direct_property_line     = indent sort_a_direct_property line_end 
sort_a_direct_property          = "column" ":" ws string_like_value

sort_a_group_block              = sort_a_sort

sort_a_sort                      = indent "sort" ws "{" line_end sort_a_sort_property_line* indent "}" line_end
sort_a_sort_property_line        = indent sort_a_sort_property line_end
sort_a_sort_property             = "direction" ":" ws ( "asc" / "desc" )
                                 / "nulls" ":" ws ( "first" / "last" )
                                 / "sequence" ":" ws number