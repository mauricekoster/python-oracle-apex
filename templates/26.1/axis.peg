axis               = indent "axis" (required_ws component_id)? ws "(" line_end axis_body_line* indent ")" line_end
axis_body_line     = axis_direct_property_line
                       / axis_group_block
                       / blank_lines

axis_direct_property_line     = indent axis_direct_property line_end 
axis_direct_property          = "name" ":" ws string_like_value
                              / "showAxis" ":" ws boolean
                              / "title" ":" ws string_like_value

axis_group_block              = axis_value
                              / axis_minor_ticks

axis_value                      = indent "value" ws "{" line_end axis_value_property_line* indent "}" line_end
axis_value_property_line        = indent axis_value_property line_end
axis_value_property             = "min" ":" ws number
                                / "max" ":" ws number
                                / "format" ":" ws ( "dateShort" / "dateMedium" / "dateLong" / "dateFull" / "timeShort" / "timeMedium" / "timeLong" / "timeFull" 
                                  / "datetimeShort" / "datetimeMedium" / "datetimeLong" / "datetimeFull" / "decimal" / "currency" / "percent" )
                                / "decimalPlaces" ":" ws number
                                / "currency" ":" ws string_like_value
                                / "pattern" ":" ws string_like_value
                                / "formatScaling" ":" ws ( "none" / "auto" / "thousand" / "million" / "billion" / "trillion" / "quadrillion" )
                                / "baselineScaling" ":" ws ( "min" / "zero" )
                                / "scale" ":" ws ( "linear" / "log" )
                                / "step" ":" ws number                               

axis_minor_ticks                      = indent "minorTicks" ws "{" line_end axis_minor_ticks_property_line* indent "}" line_end
axis_minor_ticks_property_line        = indent axis_minor_ticks_property line_end
axis_minor_ticks_property             = "show" ":" ws ( "auto" / "true" / "false" )
                                      / "step" ":" ws number