validation               = indent "validation" (required_ws component_id)? ws "(" line_end validation_body_line* indent ")" line_end
validation_body_line     = validation_direct_property_line
                       / validation_group_block
                       / blank_lines

validation_direct_property_line     = indent validation_direct_property line_end 
validation_direct_property          = "name" ":" ws string_like_value

validation_group_block              = validation_execution
                                      / validation_validation
                                      / validation_error
                                      / validation_server_side_condition

validation_execution                      = indent "execution" ws "{" line_end validation_execution_property_line* indent "}" line_end
validation_execution_property_line        = indent validation_execution_property line_end
validation_execution_property             =  "sequence" ":" ws number

validation_validation                      = indent "validation" ws "{" line_end validation_validation_property_line* indent "}" line_end
validation_validation_property_line        = indent validation_validation_property line_end
validation_validation_property             = "editableRegion" ":" ws reference
                                             / "type" ":" ws ( "rowsReturned" / "noRowsReturned" / "expression" / "plsqlError" 
                                                / "functionBodyReturningBoolean" / "functionBody" / "itemIsNotNull" / "itemIsNotNullOrZero"
                                                / "itemIsNotZero" / "itemContainsNoSpaces" / "itemIsAlphanumeric" / "itemIsNumeric" 
                                                / "itemIsAValidDate" / "itemIsAValidTimestamp" / "item=Value" / "item!=Value" 
                                                / "itemIsContainedInValue" / "itemIsNotContainedInValue" / "itemContainsOnlyCharsInValue" 
                                                / "itemContainsAtLeastOneOfCharsInValue" / "itemContainsNoneOfCharsInValue" 
                                                / "itemMatchesRegexp" )
                                             / "sqlQuery" ":" ws code_block
                                             / "language" ":" ws ( "sql" / "plsql" / "javaScript-mle" )
                                             / "sqlExpression" ":" ws code_block
                                             / "plsqlExpression" ":" ws code_block
                                             / "javaScriptExpression" ":" ws code_block
                                             / "plsqlFunctionBody" ":" ws code_block
                                             / "javaScriptFunctionBody" ":" ws code_block
                                             / "plsqlCodeRaisingError" ":" ws code_block
                                             / "item" ":" ws string_like_value
                                             / "regexp" ":" ws string_like_value
                                             / "value" ":" ws code_block
                                             / "column" ":" ws string_like_value
                                             / "alwaysExecute" ":" ws boolean

validation_error                      = indent "error" ws "{" line_end validation_error_property_line* indent "}" line_end
validation_error_property_line        = indent validation_error_property line_end
validation_error_property             = "errorMessage" ":" ws code_block
                                        / "displayLocation" ":" ws ( "inlineWithFieldAndInNotification" / "inlineWithField" / "inlineInNotification" / "onErrorPage" )
                                        / "associatedItem" ":" ws reference
                                        / "associatedColumn" ":" ws string_like_value

validation_server_side_condition                      = indent "serverSideCondition" ws "{" line_end validation_server_side_condition_property_line* indent "}" line_end
validation_server_side_condition_property_line        = indent validation_server_side_condition_property line_end
validation_server_side_condition_property             = "whenButtonPressed" ":" ws reference
                                                        / "executionScope" ":" ws ( "forCreatedAndModifiedRows" / "allSubmittedRows" )
                                                        / "type" ":" ws string_like_value
                                                        / "sqlQuery" ":" ws code_block
                                                        / "language" ":" ws ( "sql" / "plsql" / "javaScript-mle" )
                                                        / "sqlExpression" ":" ws code_block
                                                        / "plsqlExpression" ":" ws code_block
                                                        / "javaScriptExpression" ":" ws code_block
                                                        / "plsqlFunctionBody" ":" ws code_block
                                                        / "javaScriptFunctionBody" ":" ws code_block
                                                        / "value" ":" ws string_like_value
                                                        / "item" ":" ws string_like_value
                                                        / "preference" ":" ws string_like_value
                                                        / "page" ":" ws number
                                                        / "pages" ":" ws array_of_number
                                                        / "text" ":" ws string_like_value
                                                        / "list" ":" ws array_of_string_like_value
                                                        / "executeCondition" ":" ws ( "forEachRow" / "once" )

