series               = indent "series" (required_ws component_id)? ws "(" line_end series_body_line* indent ")" line_end
series_body_line     = series_direct_property_line
                       / series_group_block
                       #/ series_child_component
                       / blank_lines

series_direct_property_line     = indent series_direct_property line_end 
series_direct_property          = "name" ":" ws string_like_value
                                / "type" ":" ws ( "lineWithArea" / "scatter" / "bubble" / "barRange" / "areaRange" / "boxPlot" / "area" / "bar" / "line" )

series_group_block              = series_execution
                                / series_source
                                / series_column_mapping
                                / series_line

series_execution                      = indent "execution" ws "{" line_end series_execution_property_line* indent "}" line_end
series_execution_property_line        = indent series_execution_property line_end
series_execution_property             = "sequence" ":" ws number

series_source                      = indent "source" ws "{" line_end series_source_property_line* indent "}" line_end
series_source_property_line        = indent series_source_property line_end
series_source_property             = "location" ":" ws ( "localDatabase" / "restEnabledSql" / "restSource" / "jsonDualityView" / "jsonSource" / "regionSource" / "sampleData" )
                                   / "remoteServer" ":" ws reference
                                   / "sampleData" ":" ws ( "employees" / "tasks" / "products" / "projects" )
                                   / "type" ":" ws string_like_value
                                   / "tableOwner" ":" ws string_like_value
                                   / "tableName" ":" ws string_like_value
                                   / "includeRowidColumn" ":" ws boolean 
                                   / "whereClause" ":" ws code_block
                                   / "graphOwner" ":" ws string_like_value
                                   / "graphName" ":" ws string_like_value
                                   / "matchClause" ":" ws code_block
                                   / "columnsClause" ":" ws code_block
                                   / "sqlQuery" ":" ws code_block
                                   / "language" ":" ws ( "plsql" / "javaScript-mle" )
                                   / "plsqlFunctionBody" ":" ws code_block
                                   / "javaScriptFunctionBody" ":" ws code_block
                                   / "restSource" ":" ws reference
                                   / "jsonDualityView" ":" ws reference
                                   / "jsonSource" ":" ws reference
                                   / "pageItemsToSubmit" ":" ws one_or_more_string_like_values
                                   / "optimizerHint" ":" ws string_like_value

series_column_mapping                      = indent "columnMapping" ws "{" line_end series_column_mapping_property_line* indent "}" line_end
series_column_mapping_property_line        = indent series_column_mapping_property line_end
series_column_mapping_property             = "seriesName" ":" ws string_like_value
                                           / "label" ":" ws string_like_value
                                           / "valueAggregation" ":" ws ( "countDistinct" / "count" / "sum" / "average" / "median" / "min" / "max" / "approxCountDistinct" )
                                           / "value" ":" ws string_like_value
                                           / "open" ":" ws string_like_value
                                           / "low" ":" ws string_like_value
                                           / "high" ":" ws string_like_value
                                           / "close" ":" ws string_like_value
                                           / "volume" ":" ws string_like_value
                                           / "x" ":" ws string_like_value
                                           / "y" ":" ws string_like_value
                                           / "z" ":" ws string_like_value
                                           / "targetValue" ":" ws string_like_value
                                           / "minValue" ":" ws string_like_value
                                           / "maxValue" ":" ws string_like_value
                                           / "rowId" ":" ws string_like_value
                                           / "rowName" ":" ws string_like_value
                                           / "taskId" ":" ws string_like_value
                                           / "taskName" ":" ws string_like_value
                                           / "taskStartDate" ":" ws string_like_value
                                           / "taskEndDate" ":" ws string_like_value
                                           / "progress" ":" ws string_like_value
                                           / "baselineStartDate" ":" ws string_like_value
                                           / "baselineEndDate" ":" ws string_like_value
                                           / "customTooltip" ":" ws string_like_value
                                           / "legendTooltip" ":" ws string_like_value
                                           / "labelTooltip" ":" ws string_like_value
                                           / "customColumn" ":" ws string_like_value


series_line                      = indent "line" ws "{" line_end series_line_property_line* indent "}" line_end
series_line_property_line        = indent series_line_property line_end
series_line_property             = "style" ":" ws ( "dotted" / "dashed" / "solid" ) 
                                 / "width" ":" ws number
                                 / "type" ":" ws ( "centeredStepped" / "curved" / "centeredSegmented" / "stepped" / "segmented" / "straight" / "auto" / "none" ) 

# series_child_component          = parameter_k
