action                            = indent "action" (required_ws component_id)? ws "(" line_end action_body_line* indent ")" line_end
action_body_line                  = action_direct_property_line
                                    / action_group_block
                                    / blank_lines

action_direct_property_line       = indent action_direct_property line_end
action_direct_property            = "name" ":" ws string_like_value
                                    / "action" ":" ws string_like_value
                                    / "type" ":" ws ( "button" / "fullCard" / "title" / "subtitle" / "media" ) 
                                    / "label" ":" ws string_like_value
                                    / "position" ":" ws string_like_value
                                    / "template" ":" ws string_like_value

action_group_block                = action_affected_elements
                                    / action_appearance
                                    / action_behavior
                                    / action_execution
                                    / action_layout
                                    / action_settings

action_child_component            = menu

action_affected_elements          = indent "affectedElements" ws "{" line_end action_affected_elements_property_line* indent "}" line_end
action_affected_elements_property_line = indent action_affected_elements_property line_end
action_affected_elements_property = "selectionType" ":" ws string_like_value
                                    / "region" ":" ws reference
                                    / "columns" ":" ws one_or_more_string_like_values
                                    / "button" ":" ws reference
                                    / "items" ":" ws one_or_more_string_like_values
                                    / "domObject" ":" ws string_like_value
                                    / "jquerySelector" ":" ws string_like_value
                                    / "javaScriptExpression" ":" ws code_block

action_appearance                  = indent "appearance" ws "{" line_end action_appearance_property_line* indent "}" line_end
action_appearance_property_line    = indent action_appearance_property line_end
action_appearance_property         = "displayType" ":" ws ( "text" / "icon" / "textWithIcon" )
                                    / "icon" ":" ws string_like_value
                                    / "hot" ":" ws boolean
                                    / "cssClasses" ":" ws one_or_more_string_like_values
                                    / "showAsDisabled" ":" ws boolean

action_behavior                   = indent "behavior" ws "{" line_end action_behavior_property_line* indent "}" line_end
action_behavior_property_line     = indent action_behavior_property line_end
action_behavior_property          = "type" ":" ws ( "redirectThisApp" / "redirectOtherApp" / "redirectUrl" / "triggerAction" )
                                    / "target" ":" ws value
                                    / "targetUrl" ":" ws string_like_value
                                    / "linkAttributes" ":" ws string_like_value

action_execution                  = indent "execution" ws "{" line_end action_execution_property_line* indent "}" line_end
action_execution_property_line    = indent action_execution_property line_end
action_execution_property         = "sequence" ":" ws number
                                    / "event" ":" ws reference
                                    / "fireWhenEventResultIs" ":" ws string_like_value
                                    / "fireOnInit" ":" ws boolean
                                    / "stopExecutionOnError" ":" ws boolean
                                    / "waitForResult" ":" ws boolean


action_layout                     = indent "layout" ws "{" line_end action_layout_property_line* indent "}" line_end
action_layout_property_line       = indent action_layout_property line_end
action_layout_property            = "position" ":" ws ( "primary" / "secondary" ) 
                                    / "sequence" ":" ws number



# This group is undocumented
action_settings                      = indent "settings" ws "{" line_end action_settings_property_line* indent "}" line_end
action_settings_property_line        = indent action_settings_property line_end
action_settings_property             = "type" ":" ws ( "sqlQuery" / "something-else" )
                                       / "sqlQuery" ":" ws code_block
                                       / "plsqlCode" ":" ws code_block
                                       / "itemsToSubmit" ":" ws one_or_more_string_like_values