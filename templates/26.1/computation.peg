computation                       = indent "computation" (required_ws component_id)? ws "(" line_end computation_body_line* indent ")" line_end
computation_body_line             = computation_direct_property_line
                                    / computation_group_block
                                    / blank_lines
                                    
computation_direct_property_line  = indent computation_direct_property line_end
computation_direct_property       = "itemName" ":" ws string_like_value

computation_group_block           = computation_execution
                                    / computation_computation

computation_execution             = indent "execution" ws "{" line_end computation_execution_property_line* indent "}" line_end
computation_execution_property_line = indent computation_execution_property line_end
computation_execution_property    = "sequence" ":" ws number
                                    / "point" ":" ws ( "newSession" / "beforeHeader" / "afterHeader" / "beforeRegions" / "afterRegions" / "beforeFooter" / "afterFooter" / "afterSubmit" )

computation_computation           = indent "computation" ws "{" line_end computation_computation_property_line* indent "}" line_end
computation_computation_property_line = indent computation_computation_property line_end
computation_computation_property  = "type" ":" ws ( "staticValue" / "item" / "sqlQuerySingleValue" / "sqlQueryMultipleValues" / "expression" / "functionBody" / "preference" )
                                    / "staticValue" ":" ws string_like_value
                                    / "sqlQuery" ":" ws code_block
                                    / "computationProcessed" ":" ws ( "newSession" / "replaceExisting" / "addToExisting" / "raiseErrorOnReplace" / "replaceNullValues" )
                                    / "language" ":" ws ( "sql" / "plsql" / "javaScript-mle" )
                                    / "sqlExpression" ":" ws code_block
                                    / "plsqlExpression" ":" ws code_block
                                    / "javaScriptExpression" ":" ws code_block
                                    / "plsqlFunctionBody" ":" ws code_block
                                    / "javaScriptFunctionBody" ":" ws code_block
                                    / "itemName" ":" ws string_like_value
                                    / "preference" ":" ws string_like_value
