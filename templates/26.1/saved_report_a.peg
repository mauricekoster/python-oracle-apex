saved_report_a               = indent "savedReport" (required_ws component_id)? ws "(" line_end saved_report_a_body_line* indent ")" line_end
saved_report_a_body_line     = saved_report_a_direct_property_line
                       / saved_report_a_group_block
                       / saved_report_a_child_component
                       / blank_lines

saved_report_a_direct_property_line     = indent saved_report_a_direct_property line_end 
saved_report_a_direct_property          = "visibility" ":" ws ( "primaryDefault" / "alternativeDefault" / "public" / "private" )
                                        / "name" ":" ws string_like_value
                                        / "staticId" ":" ws string_like_value


saved_report_a_group_block              = saved_report_a_description
                                        / saved_report_a_view

saved_report_a_child_component          = aggregate_a
                                        / display_column_a
                                        / sort_a


saved_report_a_description                      = indent "description" ws "{" line_end saved_report_a_description_property_line* indent "}" line_end
saved_report_a_description_property_line        = indent saved_report_a_description_property line_end
saved_report_a_description_property             = "description" ":" ws code_block

saved_report_a_view                      = indent "view" ws "{" line_end saved_report_a_view_property_line* indent "}" line_end
saved_report_a_view_property_line        = indent saved_report_a_view_property line_end
saved_report_a_view_property             = "chart" ":" ws boolean
                                         / "groupBy" ":" ws boolean
                                         / "pivot" ":" ws boolean
                                         / "default" ":" ws string_like_value
                                         / "rowsPerPage" ":" ws string_like_value