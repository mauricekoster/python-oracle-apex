filter_c               = indent "filter" (required_ws component_id)? ws "(" line_end filter_c_body_line* indent ")" line_end
filter_c_body_line     = filter_c_direct_property_line
                       / filter_c_group_block
                       / blank_lines

filter_c_direct_property_line     = indent filter_c_direct_property line_end 
filter_c_direct_property          = "name" ":" ws string_like_value 
                                  / "type" ":" ws string_like_value 
                                  # Test purpose
                                  / "variant" ":" ws "filter_c"

filter_c_group_block              = filter_c_label
                                  / filter_c_lov
                                  / filter_c_layout
                                  / filter_c_suggestions
                                  / filter_c_source

filter_c_label                      = indent "label" ws "{" line_end filter_c_label_property_line* indent "}" line_end
filter_c_label_property_line        = indent filter_c_label_property line_end
filter_c_label_property             = "label" ":" ws string_like_value

filter_c_lov                      = indent "lov" ws "{" line_end filter_c_lov_property_line* indent "}" line_end
filter_c_lov_property_line        = indent filter_c_lov_property line_end
filter_c_lov_property             = "type" ":" ws string_like_value 
                                  / "lov" ":" ws reference 
                                  / "sqlQuery" ":" ws code_block 
                                  / "staticValues" ":" ws code_block 
                                  / "language" ":" ws ( "plsql" / "javaScript-mle" ) 
                                  / "plsqlFunctionBody" ":" ws code_block 
                                  / "javaScriptFunctionBody" ":" ws code_block 
                                  / "sortDirection" ":" ws ( "asc" / "desc" ) 
                                  / "includeNullOption" ":" ws boolean 
                                  / "nullDisplayValue" ":" ws string_like_value 

filter_c_layout                      = indent "layout" ws "{" line_end filter_c_layout_property_line* indent "}" line_end
filter_c_layout_property_line        = indent filter_c_layout_property line_end
filter_c_layout_property             = "sequence" ":" ws number

filter_c_suggestions                      = indent "suggestions" ws "{" line_end filter_c_suggestions_property_line* indent "}" line_end
filter_c_suggestions_property_line        = indent filter_c_suggestions_property line_end
filter_c_suggestions_property             = "type" ":" ws ( "dynamic" / "staticValues" / "sqlQuery" ) 
                                          / "staticValues" ":" ws array_of_string_like_value 
                                          / "sqlQuery" ":" ws code_block 
                                          / "showLabel" ":" ws boolean 

filter_c_source                      = indent "source" ws "{" line_end filter_c_source_property_line* indent "}" line_end
filter_c_source_property_line        = indent filter_c_source_property line_end
filter_c_source_property             = "databaseColumn" ":" ws string_like_value 
                                     / "dbColumns" ":" ws string_like_value 
                                     / "dataType" ":" ws ( "varchar2" / "number" / "date" / "timestamp" / "timestampWithTimeZone" / "timestampWithLocalTimeZone" / "intervalYearToMonth" / "intervalDayToSecond" / "clob" / "blob" / "boolean" / "rowid" / "bfile" / "sdoGeometry" ) 
