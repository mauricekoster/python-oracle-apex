process                             = indent "process" (required_ws component_id)? ws "(" line_end process_body_line* indent ")" line_end
process_body_line                   = process_direct_property_line
                                    / process_group_block
                                    / blank_lines

process_direct_property_line        = indent process_direct_property line_end
process_direct_property             = "name" ":" ws string_like_value
                                    / "type" ":" ws string_like_value
                                    / "executionChain" ":" ws string_like_value
                                    / "formRegion" ":" ws reference
                                    / "editableRegion" ":" ws reference

process_group_block                 = process_execution
                                    / process_source
                                    / process_advanced
                                    / process_target
                                    / process_server_side_condition
                                    / process_success_message
                                    / process_error

process_source                      = indent "source" ws "{" line_end process_source_property_line* indent "}" line_end
process_source_property_line        = indent process_source_property line_end
process_source_property             = "location" ":" ws ( "localDatabase" / "restEnabledSql" )
                                    / "language" ":" ws ( "plsql" / "javaScript-mle" )
                                    / "plsqlCode" ":" ws code_block
                                    / "javaScriptCode" ":" ws code_block
                                    / "remoteServer" ":" ws reference
                                    # UNDOCUMENTED:
                                    / "tableName" ":" ws string_like_value
                                    / "pkColumn" ":" ws string_like_value
                                    / "pkItem" ":" ws string_like_value

process_execution                   = indent "execution" ws "{" line_end process_execution_property_line* indent "}" line_end
process_execution_property_line     = indent process_execution_property line_end
process_execution_property          = "sequence" ":" ws number
                                    / "point" ":" ws string_like_value
                                    / "runProcess" ":" ws ( "oncePerSessionOrWhenReset" / "oncePerPageVisitDefault" )


process_advanced                    = indent "advanced" ws "{" line_end process_advanced_property_line* indent "}" line_end
process_advanced_property_line      = indent process_advanced_property line_end
process_advanced_property           = "staticId" ":" ws string_like_value
                                    / "executionMappingIdentifier" ":" ws string_like_value

# plugin type : autoRowProcessing
# ref: https://docs.oracle.com/en/database/oracle/apex/26.1/apxln/api-docs.html?component=process-auto-row-processing
process_target                      = indent "target" ws "{" line_end process_target_property_line* indent "}" line_end
process_target_property_line        = indent process_target_property line_end
process_target_property             = "tableName" ":" ws string_like_value
                                    / "pkColumn" ":" ws string_like_value
                                    / "pkItem" ":" ws string_like_value
                                    / "returnKeyIntoItem" ":" ws string_like_value

process_success_message                      = indent "successMessage" ws "{" line_end process_success_message_property_line* indent "}" line_end
process_success_message_property_line        = indent process_success_message_property line_end
process_success_message_property             =  "successMessage" ":" ws code_block

process_error                      = indent "error" ws "{" line_end process_error_property_line* indent "}" line_end
process_error_property_line        = indent process_error_property line_end
process_error_property             = "errorMessage" ":" ws code_block
                                   / "displayLocation" ":" ws ( "inlineInNotification" / "onErrorPage" )

process_server_side_condition                      = indent "serverSideCondition" ws "{" line_end process_server_side_condition_property_line* indent "}" line_end
process_server_side_condition_property_line        = indent process_server_side_condition_property line_end
process_server_side_condition_property             = "whenButtonPressed" ":" ws reference
                                                   / "executionScope" ":" ws ( "forCreatedAndModifiedRows" / "allSubmittedRows" )
                                                   / "type" ":" ws string_like_value
                                                   / "sqlQuery" ":" ws code_block
                                                   / "language" ":" ws ( "sql" / "plsql" / "javaScript-mle" )
                                                   / "sqlExpression" ":" ws code_block
                                                   / "plsqlExpression" ":" ws code_block
                                                   / "javaScriptExpression" ":" ws code_block
                                                   / "plsqlFunctionBody" ":" ws code_block
                                                   / "javaScriptFunctionBody" ":" ws code_block
                                                   / "value" ":" ws string_like_value
                                                   / "item" ":" ws string_like_value
                                                   / "preference" ":" ws string_like_value
                                                   / "page" ":" ws number
                                                   / "pages" ":" ws array_of_number
                                                   / "text" ":" ws string_like_value
                                                   / "list" ":" ws array_of_string_like_value
                                                   / "executeCondition" ":" ws ( "forEachRow" / "once" )
