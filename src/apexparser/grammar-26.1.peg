                                "timestampWithTimeZone" / "timestampWithLocalTimeZone" / 
                                "intervalYearToMonth" / "intervalDayToSecond" / 
                                "clob" / "blob" / "boolean" / "rowid" / "bfile" / "sdoGeometry" )

