component                           = page_item blank_lines
                                    / dynamic_action blank_lines
                                    / branch_a  blank_lines
                                    / action_c  blank_lines
                                    / action_d blank_lines
                                    / action_e blank_lines
                                    / process blank_lines
                                    / button blank_lines
                                    / computation_a blank_lines
                                    / facet blank_lines
                                    / column_b blank_lines
                                    / column_c blank_lines
                                    / column_f blank_lines
                                    / series blank_lines
                                    / axis blank_lines
                                    / region blank_lines
                                    / page_object blank_lines
page_object                         = indent "page" (required_ws component_id)? ws "(" page_body_line* indent ")" line_end
page_body_line                      = page_direct_property_line
                                    / page_group_block
                                    / page_child_component
                                    / blank_lines

page_direct_property_line           = indent page_direct_property line_end
page_direct_property                = "page" ":" ws number
                                    / "name" ":" ws string_like_value
                                    / "alias" ":" ws string_like_value
                                    / "title" ":" ws string_like_value
                                    / "pageGroup" ":" ws reference

page_group_block                    = page_appearance
                                    / page_advanced
                                    / page_css
                                    / page_help
                                    / page_html_header
                                    / page_navigation
                                    / page_security

page_appearance                     = indent "appearance" ws "{" line_end page_appearance_property_line* indent "}" line_end
page_appearance_property_line       = indent page_appearance_property line_end
page_appearance_property            = "pageMode" ":" ws ( "normal" / "modalDialog" / "nonModalDialog" )
                                    / "pageTemplate" ":" ws reference
                                    / "dialogTemplate" ":" ws reference
                                    / "templateOptions" ":" ws one_or_more_string_like_values
                                    / "cssClasses" ":" ws one_or_more_string_like_values
                                    / "mediaType" ":" ws string_like_value

page_html_header                    = indent "htmlHeader" ws "{" line_end page_html_header_property_line* indent "}" line_end
page_html_header_property_line      = indent page_html_header_property line_end
page_html_header_property           = "htmlHeader" ":" ws code_block
                                    / "pageHtmlBodyAttribute" ":" ws code_block

page_navigation                     = indent "navigation" ws "{" line_end page_navigation_property_line* indent "}" line_end
page_navigation_property_line       = indent page_navigation_property line_end
page_navigation_property            = "cursorFocus" ":" ws ( "firstItemOnPage" / "doNotFocusCursor" )
                                    / "warnOnUnsavedChanges" ":" ws boolean

page_css                            = indent "css" ws "{" line_end page_css_property_line* indent "}" line_end
page_css_property_line              = indent page_css_property line_end
page_css_property                   = "fileUrls" ":" ws array_of_string_like_value
                                    / "inline" ":" ws multiline_string
                                    / "inline" ":" nl indent multiline_string

page_security                       = indent "security" ws "{" line_end page_security_property_line* indent "}" line_end
page_security_property_line         = indent page_security_property line_end
page_security_property              = "authorizationScheme" ":" ws reference
                                    / "authentication" ":" ws ( "required" / "public" ) 
                                    / "deepLinking" ":" ws boolean
                                    / "pageAccessProtection" ":" ws ( "unrestricted" / "argumentsMustHaveChecksum" / "noArgumentsSupported" / "noUrlAccess" )
                                    / "formAutoComplete" ":" ws boolean
                                    / "browserCache" ":" ws boolean

page_advanced                       = indent "advanced" ws "{" line_end page_advanced_property_line* indent "}" line_end
page_advanced_property_line         = indent page_advanced_property line_end
page_advanced_property              = "enableMetaTags" ":" ws boolean
                                    / "enableDuplicatePageSubmissions" ":" ws boolean
                                    / "reloadOnSubmit" ":" ws ( "always" / "onlyForSuccess" )
                                    / "duplicateSubmissionUrl" ":" ws string_like_value


page_help                           = indent "help" ws "{" line_end page_help_property_line* indent "}" line_end
page_help_property_line             = indent page_help_property line_end
page_help_property                  = "helpText" ":" ws code_block



page_child_component                = region
                                    / page_item
                                    / button
                                    / dynamic_action
                                    / process
                                    / computation_a
                                    / branch_a
#####
# REGION
#####

region                              = indent "region" (required_ws component_id)? ws "(" line_end region_body_line* indent ")" line_end
region_body_line                    = region_direct_property_line
                                    / region_group_block
                                    / region_child_component
                                    / blank_lines

region_direct_property_line         = indent region_direct_property line_end                               
region_direct_property              = "name" ":" ws string_like_value
                                    / "title" ":" ws string_like_value
                                    / "type" ":" ws string_like_value

region_group_block                  = region_layout
                                    / region_accessibility
                                    / region_advanced
                                    / region_appearance
                                    / region_chart
                                    / region_chart_layout
                                    / region_component_appearance
                                    / region_component_advanced
                                    / region_image
                                    / region_legend
                                    / region_messages
                                    / region_pagination
                                    / region_performance
                                    / region_plugin_avatar
                                    / region_plugin_badge
                                    / region_report_layout
                                    / region_server_side_condition
                                    / region_settings
                                    / region_source
                                    / region_title

region_layout                       = indent "layout" ws "{" line_end region_layout_property_line* indent "}" line_end
region_layout_property_line         = indent region_layout_property line_end
region_layout_property              = "sequence" ":" ws number
                                    / "parentRegion" ":" ws reference
                                    / "slot" ":" ws string_like_value
                                    / "startNewLayout" ":" ws boolean
                                    / "startNewRow" ":" ws boolean
                                    / "rowCssClasses" ":" ws array_of_string_like_value
                                    / "column" ":" ws string_like_value
                                    / "newColumn" ":" ws boolean
                                    / "columnSpan" ":" ws string_like_value
                                    / "columnCssClasses" ":" ws array_of_string_like_value
                                    / "columnAttributes" ":" ws array_of_string_like_value

region_appearance                   = indent "appearance" ws "{" line_end region_appearance_property_line* indent "}" line_end
region_appearance_property_line     = indent region_appearance_property line_end
region_appearance_property          = "template" ":" ws reference
                                    / "templateOptions" ":" ws (array_of_string_like_value / string_like_value)
                                    / "cssClasses" ":" ws array_of_string_like_value
                                    / "icon" ":" ws string_like_value
                                    / "renderComponents" ":" ws ( "aboveContent" / "belowContent" ) 

region_image                        = indent "image" ws "{" line_end region_image_property_line* indent "}" line_end
region_image_property_line          = indent region_image_property line_end
region_image_property               = "fileUrl" ":" ws string_like_value
                                    / "accessibleDescription" ":" ws string_like_value
                                    / "customAttributes" ":" ws string_like_value

region_advanced                     = indent "advanced" ws "{" line_end region_advanced_property_line* indent "}" line_end
region_advanced_property_line       = indent region_advanced_property line_end
region_advanced_property            = "savedReportMappingIdentifier" ":" ws string_like_value
                                    / "htmlDomId" ":" ws string_like_value
                                    / "customAttributes" ":" ws string_like_value
                                    / "regionImage" ":" ws string_like_value
                                    / "imageTagAttributes" ":" ws string_like_value
                                    / "staticId" ":" ws string_like_value
                                    / "regionDisplaySelector" ":" ws boolean
                                    / "excludeTitleFromTranslation" ":" ws boolean
                                    / "schemaOverrideItem" ":" ws string_like_value

region_source                       = indent "source" ws "{" line_end region_source_property_line* indent "}" line_end
region_source_property_line         = indent region_source_property line_end
region_source_property              = "sqlQuery" ":" ws code_block
                                    / "plsqlCode" ":" ws code_block
                                    / "plsqlFunctionBody" ":" ws code_block
                                    / "htmlCode" ":" ws code_block
                                    / "text" ":" ws multiline_string
                                    / "language" ":" ws ( "plsql" / "javaScript-mle" )
                                    / "javaScriptFunctionBody" ":" ws code_block
                                    / "location" ":" ws ( "localDatabase" / "restEnabledSql" / "restSource" / "jsonDualityView" / "jsonSource" / "sampleData" )
                                    / "remoteServer" ":" ws reference
                                    / "sampleData" ":" ws ( "employees" / "tasks" / "products" / "projects" )
                                    / "type" ":" ws string_like_value
                                    / "tableOwner" ":" ws string_like_value
                                    / "tableName" ":" ws string_like_value
                                    / "includeRowidColumn" ":" ws boolean
                                    / "whereClause" ":" ws multiline_string
                                    / "graphOwner" ":" ws string_like_value
                                    / "graphName" ":" ws string_like_value
                                    / "matchClause" ":" ws multiline_string
                                    / "columnsClause" ":" ws multiline_string
                                    / "orderByClause" ":" ws multiline_string
                                    / "restSource" ":" ws reference
                                    / "jsonDualityView" ":" ws reference
                                    / "jsonSource" ":" ws reference
                                    / "list" ":" ws reference
                                    / "breadcrumb" ":" ws reference
                                    / "filteredRegion" ":" ws reference
                                    / "pageItemsToSubmit" ":" ws array_of_string_like_value
                                    / "optimizerHint" ":" ws string_like_value
                                    / "useGenericColumnNames" ":" ws boolean
                                    / "genericColumnCount" ":" ws number


region_component_appearance         = indent "componentAppearance" ws "{" line_end region_component_appearance_property_line* indent "}" line_end
region_component_appearance_property_line = indent region_component_appearance_property line_end
region_component_appearance_property = "display" ":" ws string_like_value
                                    / "layout" ":" ws ( "grid" / "float" / "horizontal" )
                                    / "gridColumns" ":" ws ( "2" / "3" / "4" / "5" )
                                    / "listTemplate" ":" ws reference
                                    / "breadcrumbTemplate" ":" ws reference
                                    / "cssClasses" ":" ws one_or_more_string_like_values
                                    / "templateOptions" ":" ws one_or_more_string_like_values
                                    / "templateType" ":" ws ( "theme" / "predefined" )
                                    / "template" ":" ws ( "html" / "verticalReport" / "csv" / "xml" / reference )
                                    / "customAttributes" ":" ws string_like_value
                                    / "showNullValuesAs" ":" ws string_like_value
                                    / "selectFirstRow" ":" ws boolean
                                    / "fixedRowHeight" ":" ws boolean

region_settings                     = indent "settings" ws "{" line_end region_settings_property_line* indent "}" line_end
region_settings_property_line       = indent region_settings_property line_end
region_settings_property            = "timeAxisType" ":" ws ( "auto" / "disabled" / "enabled" / "mixedFrequency" / "skipGaps" ) 
                                    / "zoomAndScroll" ":" ws ( "false" / "delayedScrollOnly" / "delayed" / "liveScrollOnly" / "live" )
                                    / "zoomDirection" ":" ws ( "bothAxes" / "xAxis" / "yAxis" )
                                    / "initialZooming" ":" ws ( "first" / "last" / "none" )
                                    / "showHorizontalGrid" ":" ws ( "auto" / "true" / "false" )
                                    / "showVerticalGrid" ":" ws ( "auto" / "true" / "false" )
                                    / "showRowAxis" ":" ws boolean
                                    / "axisPosition" ":" ws ( "top" / "bottom" )
                                    / "pieSelectionEffect" ":" ws ( "explode" / "highlightAndExplode" / "highlight" )
                                    / "renderAs" ":" ws ( "area" / "bar" / "candlestick" / "lineWithArea" / "line" )

# UNDOCUMENTED! used in brookstrut page 2 (type: Faceted Search)
                                    / "compactNosThreshold" ":" ws number
                                    / "showCurrentFacets" ":" ws ( "selector" )
                                    / "currentFacetsSelector" ":" ws string_like_value
                                    / "displayChartForTopNValues" ":" ws number

                                    / "title" ":" ws string_like_value
                                    / "description" ":" ws code_block
                                    / "miscellaneous" ":" ws code_block
                                    / "displayAvatar" ":" ws boolean
                                    / "displayBadge" ":" ws boolean

region_plugin_avatar                = indent "plugin-avatar" ws "{" line_end region_plugin_avatar_property_line* indent "}" line_end
region_plugin_avatar_property_line  = indent region_plugin_avatar_property line_end
region_plugin_avatar_property       = "icon" ":" ws string_like_value

region_plugin_badge                 = indent "plugin-badge" ws "{" line_end region_plugin_badge_property_line* indent "}" line_end
region_plugin_badge_property_line   = indent region_plugin_badge_property line_end
region_plugin_badge_property        = "label" ":" ws string_like_value
                                    / "value" ":" ws string_like_value

region_accessibility                = indent "accessibility" ws "{" line_end region_accessibility_property_line* indent "}" line_end
region_accessibility_property_line  = indent region_accessibility_property line_end
region_accessibility_property       = "useLandmark" ":" ws boolean
                                    / "landmarkType" ":" ws ( "banner" / "complementary" / "contentInfo" / "form" / "main" / "navigation" / "region" / "search" )
                                    / "landmarkLabel" ":" ws string_like_value

region_pagination                   = indent "pagination" ws "{" line_end region_pagination_property_line* indent "}" line_end
region_pagination_property_line     = indent region_pagination_property line_end
region_pagination_property          = "type" ":" ws ( "rowRangesXToYNoPagination" / "rowRangesXToYOfZNoPagination" /
                                         "rowRangesXToYOfZWithPagination" / "setPaginationLinks" /
                                         "setPaginationSelectList" / "setPaginationSearchEngine" / 
                                         "externalPaginationButtons" / "nextAndPreviousLinks" /
                                         "page" / "scroll" 
                                         )
                                    / "type" ":" ws string_like_value
                                    / "displayPosition" ":" ws ( "bottomLeft" / "bottomRight" / "topLeft" / "topRight" /
                                             "topAndBottomLeft" / "topAndBottomRight" )
                                    / "partialPageRefresh" ":" ws boolean
                                    / "showTotalCount" ":" ws boolean
                                    / "maxRowsToDisplay" ":" ws string_like_value
                                    / "cardsPerPage" ":" ws number
                                    / "entitiesPerPage" ":" ws number
                                    / "initialEntitiesCount" ":" ws number

region_report_layout                      = indent "reportLayout" ws "{" line_end region_report_layout_property_line* indent "}" line_end
region_report_layout_property_line        = indent region_report_layout_property line_end
region_report_layout_property             = "numberOfRowsType" ":" ws ( "staticValue" / "itemValue" ) 
                                          / "numberOfRows" ":" ws number
                                          / "item" ":" ws string_like_value


region_performance                      = indent "performance" ws "{" line_end region_performance_property_line* indent "}" line_end
region_performance_property_line        = indent region_performance_property line_end
region_performance_property             = "lazyLoading" ":" ws boolean
                                        / "maxRowsToProcess" ":" ws number

region_messages                      = indent "messages" ws "{" line_end region_messages_property_line* indent "}" line_end
region_messages_property_line        = indent region_messages_property line_end
region_messages_property             = "whenNoDataFound" ":" ws code_block
                                     / "whenMoreDataFound" ":" ws code_block
                                     / "noDataFoundIcon" ":" ws string_like_value

region_component_advanced                      = indent "componentAdvanced" ws "{" line_end region_component_advanced_property_line* indent "}" line_end
region_component_advanced_property_line        = indent region_component_advanced_property line_end
region_component_advanced_property             = "stripHtml" ":" ws boolean
                                               / "sortNulls" ":" ws ( "first" / "last" ) 
                                               / "customSvgStyles" ":" ws code_block
                                               / "oracleTextIndexColumn" ":" ws string_like_value
                                               / "emailFromAddress" ":" ws string_like_value
                                               / "initJavaScriptFunction" ":" ws code_block
                                               / "regionAlias" ":" ws string_like_value 
                                               / "reportIdItem" ":" ws string_like_value
                                               / "maxRowsPerPageInSelector" ":" ws string_like_value

region_chart                      = indent "chart" ws "{" line_end region_chart_property_line* indent "}" line_end
region_chart_property_line        = indent region_chart_property line_end
region_chart_property             = "type" ":" ws ( "area" / "bar" / "boxPlot" / "bubble" / "combination" / "statusMeterGauge" / "donut" 
                                             / "funnel" / "gantt"  / "lineWithArea" / "line" / "pie" / "polar" / "pyramid" / "radar" 
                                             / "range" / "scatter" / "stock" )

region_title                      = indent "title" ws "{" line_end region_title_property_line* indent "}" line_end
region_title_property_line        = indent region_title_property line_end
region_title_property             = "title" ":" ws string_like_value
                                  / "advancedFormatting" ":" ws boolean
                                  / "column" ":" ws string_like_value
                                  / "htmlExpression" ":" ws code_block
                                  / "cssClasses" ":" ws one_or_more_string_like_values

region_chart_layout                      = indent "chartLayout" ws "{" line_end region_chart_layout_property_line* indent "}" line_end
region_chart_layout_property_line        = indent region_chart_layout_property line_end
region_chart_layout_property             = "maxWidth" ":" ws number
                                         / "height" ":" ws number

region_legend                      = indent "legend" ws "{" line_end region_legend_property_line* indent "}" line_end
region_legend_property_line        = indent region_legend_property line_end
region_legend_property             = "show" ":" ws boolean
                                   / "title" ":" ws string_like_value
                                   / "position" ":" ws ( "start" / "end" / "selector" ) 
                                   / "selector" ":" ws string_like_value
                                   / "cssClasses" ":" ws one_or_more_string_like_values
                                   / "hideAndShowBehavior" ":" ws ( "none" / "rescale" / "noRescaling" )
                                   / "fontFamily" ":" ws ( "arialBlack" / "arial"  / "bookman" / "comicSansMs"  / "courierNew" / "courier"
                                        / "garamond" / "georgia" / "helvetica" / "impact" / "palatino" / "timesNewRoman" / "times" / "trebuchetMs" / "verdana" )
                                   / "fontStyle" ":" ws ( "normal" / "italic" / "oblique" ) 
                                   / "fontSize" ":" ws ( "8" / "10" / "12" / "14" / "16" / "18" / "20" / "22" )
                                   / "fontColor" ":" ws string_like_value

region_server_side_condition                      = indent "serverSideCondition" ws "{" line_end region_server_side_condition_property_line* indent "}" line_end
region_server_side_condition_property_line        = indent region_server_side_condition_property line_end
region_server_side_condition_property             = "type" ":" ws string_like_value
                                                  / "sqlQuery" ":" ws code_block
                                                  / "language" ":" ws ( "sql" / "plsql" / "javaScript-mle" )
                                                  / "sqlExpression" ":" ws code_block
                                                  / "plsqlExpression" ":" ws code_block
                                                  / "javaScriptExpression" ":" ws code_block
                                                  / "plsqlFunctionBody" ":" ws code_block
                                                  / "javaScriptFunctionBody" ":" ws code_block
                                                  / "value" ":" ws string_like_value
                                                  / "item" ":" ws string_like_value
                                                  / "preference" ":" ws string_like_value
                                                  / "page" ":" ws number
                                                  / "pages" ":" ws array_of_number
                                                  / "text" ":" ws string_like_value
                                                  / "list" ":" ws one_or_more_string_like_values


region_child_component              = facet
                                    / action_d
                                    / action_e
                                    / column_b
                                    / column_c
                                    / column_f
                                    / series
                                    / axis
page_item                           = indent "pageItem" (required_ws component_id)? ws "(" line_end page_item_body_line* indent ")" line_end
page_item_body_line                 = page_item_direct_property_line
                                    / page_item_group_block
                                    / blank_lines

page_item_direct_property_line      = indent page_item_direct_property line_end
page_item_direct_property           = "name" ":" ws string_like_value
                                    / "type" ":" ws string_like_value

page_item_group_block               = page_item_label
                                    / page_item_settings
                                    / page_item_layout
                                    / page_item_appearance
                                    / page_item_validation
                                    / page_item_advanced
                                    / page_item_security
                                    / page_item_session_state
                                    / page_item_lov
                                    / page_item_default

page_item_label                     = indent "label" ws "{" line_end page_item_label_property_line* indent "}" line_end
page_item_label_property_line       = indent page_item_label_property line_end
page_item_label_property            = "label" ":" ws string_like_value
                                    / "alignment" ":" ws ( "above" / "below" / "center" / "centerBottom" / "centerCenter" / "centerTop" / "left" / "leftBottom" / "leftCenter" / "leftTop" / "right" / "rightBottom" / "rightCenter" / "rightTop" )
                                    / "tableCellAttributes" ":" ws array_of_string_like_value

page_item_settings                  = indent "settings" ws "{" line_end page_item_settings_property_line* indent "}" line_end
page_item_settings_property_line    = indent page_item_settings_property line_end
page_item_settings_property         = "trimSpaces" ":" ws ( "none" / "something-else" )
                                    / "dummy" ":" ws string_like_value


page_item_layout                    = indent "layout" ws "{" line_end page_item_layout_property_line* indent "}" line_end
page_item_layout_property_line      = indent page_item_layout_property line_end
page_item_layout_property           = "sequence" ":" ws number
                                    / "region" ":" ws reference
                                    / "slot" ":" ws string_like_value
                                    / "alignment" ":" ws ( "center" / "centerBottom" / "centerCenter" / "centerTop" / "left" / "leftBottom" / "leftCenter" / "leftTop" / "right" / "rightBottom" / "rightCenter" / "rightTop" )
                                    / "startNewLayout" ":" ws boolean
                                    / "startNewRow" ":" ws boolean
                                    / "rowCssClasses" ":" ws array_of_string_like_value
                                    / "column" ":" ws string_like_value
                                    / "newColumn" ":" ws boolean
                                    / "columnSpan" ":" ws string_like_value
                                    / "rowSpan" ":" ws number
                                    / "labelColumnSpan" ":" ws string_like_value
                                    / "columnCssClasses" ":" ws array_of_string_like_value
                                    / "columnAttributes" ":" ws array_of_string_like_value

page_item_appearance                = indent "appearance" ws "{" line_end page_item_appearance_property_line* indent "}" line_end
page_item_appearance_property_line  = indent page_item_appearance_property line_end
page_item_appearance_property       = "template" ":" ws reference
                                    / "templateOptions" ":" ws one_or_more_string_like_values
                                    / "cssClasses" ":" ws one_or_more_string_like_values
                                    / "icon" ":" ws string_like_value
                                    / "formatMask" ":" ws string_like_value
                                    / "valuePlaceholder" ":" ws string_like_value
                                    / "width" ":" ws number
                                    / "height" ":" ws number

page_item_validation                = indent "validation" ws "{" line_end page_item_validation_property_line* indent "}" line_end
page_item_validation_property_line  = indent page_item_validation_property line_end
page_item_validation_property       = "valueRequired" ":" ws boolean
                                    / "maxLength" ":" ws number

page_item_advanced                  = indent "advanced" ws "{" line_end page_item_advanced_property_line* indent "}" line_end
page_item_advanced_property_line    = indent page_item_advanced_property line_end
page_item_advanced_property         = "cssClasses" ":" ws array_of_string_like_value
                                    / "customAttributes" ":" ws string_like_value
                                    / "optionHtmlAttributes" ":" ws array_of_string_like_value
                                    / "preText" ":" ws code_block
                                    / "postText" ":" ws code_block
                                    / "warnOnUnsavedChanges" ":" ws ( "ignore" )
                                    / "initJavaScriptFunction" ":" ws code_block

page_item_session_state             = indent "sessionState" ws "{" line_end page_item_session_state_property_line* indent "}" line_end
page_item_session_state_property_line  = indent page_item_session_state_property line_end
page_item_session_state_property       = "dataType" ":" ws ( "varchar2" / "clob" / "boolean" / "number" )
                                    / "storage" ":" ws ( "request" / "session" / "user" )

page_item_security                  = indent "security" ws "{" line_end page_item_security_property_line* indent "}" line_end
page_item_security_property_line    = indent page_item_security_property line_end
page_item_security_property         = "authorizationScheme" ":" ws reference
                                    / "sessionStateProtection" ":" ws ( "unrestricted" / "checksumRequiredAppLevel" / "checksumRequiredUserLevel" / "checksumRequiredSessionLevel" / "restricted" )
                                    / "encryptSessionState" ":" ws boolean
                                    / "escapeSpecialChars" ":" ws boolean
                                    / "restrictedChars" ":" ws ( "alphanumWithSpace" / "webSafe" / "noSpecialChar" / "noSpecialCharNoNewline" / "workspaceSchema" / "workspaceUserSchema" / "workspaceUserSchemaId" )

page_item_lov                       = indent "lov" ws "{" line_end page_item_lov_property_line* indent "}" line_end
page_item_lov_property_line         = indent page_item_lov_property line_end
page_item_lov_property              = "type" ":" ws ( "sharedComponent" / "sqlQuery" / "staticValues" / "functionBody" )
                                    / "lov" ":" ws reference
                                    / "sqlQuery" ":" ws code_block
                                    / "staticValues" ":" ws multiline_string
                                    / "language" ":" ws ( "plsql" / "javaScript-mle" )
                                    / "plsqlFunctionBody" ":" ws code_block
                                    / "javaScriptFunctionBody" ":" ws code_block
                                    / "displayExtraValues" ":" ws boolean
                                    / "displayNullValue" ":" ws boolean
                                    / "nullDisplayValue" ":" ws string_like_value
                                    / "nullReturnValue" ":" ws string_like_value

page_item_default                   = indent "default" ws "{" line_end page_item_default_property_line* indent "}" line_end
page_item_default_property_line     = indent page_item_default_property line_end
page_item_default_property          = "type" ":" ws ( "static" / "item" / "sqlQuerySingleValue" 
                                        / "sqlQueryMultipleValues" / "expression" / "functionBody" / "sequence" )
                                    / "staticValue" ":" ws code_block
                                    / "item" ":" ws string_like_value
                                    / "sqlQuerySingleValue" ":" ws multiline_string
                                    / "sqlQueryMultipleValues" ":" ws multiline_string
                                    / "language" ":" ws ( "sql" / "plsql" / "javaScript-mle" )
                                    / "sqlExpression" ":" ws multiline_string
                                    / "plsqlExpression" ":" ws multiline_string
                                    / "javaScriptExpression" ":" ws multiline_string
                                    / "plsqlFunctionBody" ":" ws multiline_string
                                    / "javaScriptFunctionBody" ":" ws multiline_string
                                    / "sequence" ":" ws string_like_value
button                              = indent "button" (required_ws component_id)? ws "(" line_end button_body_line* indent ")" line_end
button_body_line                    = button_direct_property_line
                                    / button_group_block
                                    / blank_lines
                                    
button_direct_property_line         = indent button_direct_property line_end                              
button_direct_property              = "buttonName" ":" ws string_like_value
                                    / "label" ":" ws string_like_value

button_group_block                  = button_layout
                                    / button_appearance
                                    / button_behavior

button_layout                       = indent "layout" ws "{" line_end button_layout_property_line* indent "}" line_end
button_layout_property_line         = indent page_item_layout_property line_end
button_layout_property              = "sequence" ":" ws number
                                    / "region" ":" ws reference
                                    / "slot" ":" ws string_like_value
                                    / "startNewLayout" ":" ws boolean
                                    / "startNewRow" ":" ws boolean
                                    / "rowCssClasses" ":" ws array_of_string_like_value
                                    / "column" ":" ws string_like_value
                                    / "newColumn" ":" ws boolean
                                    / "columnSpan" ":" ws string_like_value
                                    / "rowSpan" ":" ws number
                                    / "columnCssClasses" ":" ws array_of_string_like_value
                                    / "columnAttributes" ":" ws array_of_string_like_value
                                    / "horizontalAlignment" ":" ws ( "left" / "right" )
                                    / "alignment" ":" ws ( "center" / "centerBottom" / "centerCenter" / "centerTop" / "left" / "leftBottom" / "leftCenter" / "leftTop" / "right" / "rightBottom" / "rightCenter" / "rightTop" )

button_appearance                   = indent "appearance" ws "{" line_end button_appearance_property_line* indent "}" line_end
button_appearance_property_line     = indent button_appearance_property line_end
button_appearance_property          = "buttonTemplate" ":" ws reference
                                    / "hot" ":" ws boolean
                                    / "showAsDisabled" ":" ws boolean
                                    / "templateOptions" ":" ws ( array_of_string_like_value / string_like_value )
                                    / "cssClasses" ":" ws ( array_of_string_like_value / string_like_value )
                                    / "icon" ":" ws string_like_value

button_behavior                    = indent "behavior" ws "{" line_end button_behavior_property_line* indent "}" line_end
button_behavior_property_line       = indent button_behavior_property line_end
button_behavior_property            = "type" ":" ws string_like_value
                                    / "action" ":" ws ( "submitPage" / "triggerAction" / "redirectThisApp" / "redirectOtherApp" / "redirectUrl" / "definedByDynamicAction" / "resetPage" / "nextPage" / "previousPage" )
                                    / "target" ":" ws value
                                    / "targetUrl" ":" ws string_like_value
                                    / "executeValidations" ":" ws boolean
                                    / "showProcessing" ":" ws boolean
                                    / "warnOnUnsavedChanges" ":" ws ( "doNotCheck" )
                                    / "databaseAction" ":" ws ( "insert" / "update" / "delete" )
                                    / "requiresConfirmation" ":" ws boolean
process                             = indent "process" (required_ws component_id)? ws "(" line_end process_body_line* indent ")" line_end
process_body_line                   = process_direct_property_line
                                    / process_group_block
                                    / blank_lines

process_direct_property_line        = indent process_direct_property line_end
process_direct_property             = "name" ":" ws string_like_value
                                    / "type" ":" ws string_like_value
                                    / "executionChain" ":" ws string_like_value
                                    / "formRegion" ":" ws reference
                                    / "editableRegion" ":" ws reference

process_group_block                 = process_execution
                                    / process_source
                                    / process_advanced

process_source                      = indent "source" ws "{" line_end process_source_property_line* indent "}" line_end
process_source_property_line        = indent process_source_property line_end
process_source_property             = "location" ":" ws ( "localDatabase" / "restEnabledSql" )
                                    / "language" ":" ws ( "plsql" / "javaScript-mle" )
                                    / "plsqlCode" ":" ws code_block
                                    / "javaScriptCode" ":" ws code_block
                                    / "remoteServer" ":" ws reference


process_execution                   = indent "execution" ws "{" line_end process_execution_property_line* indent "}" line_end
process_execution_property_line     = indent process_execution_property line_end
process_execution_property          = "sequence" ":" ws number
                                    / "point" ":" ws string_like_value
                                    / "runProcess" ":" ws ( "oncePerSessionOrWhenReset" / "oncePerPageVisitDefault" )


process_advanced                    = indent "advanced" ws "{" line_end process_advanced_property_line* indent "}" line_end
process_advanced_property_line      = indent process_advanced_property line_end
process_advanced_property           = "staticId" ":" ws string_like_value
                                    / "executionMappingIdentifier" ":" ws string_like_value
computation_a                       = indent "computation" (required_ws component_id)? ws "(" line_end computation_a_body_line* indent ")" line_end
computation_a_body_line             = computation_a_direct_property_line
                                    / computation_a_group_block
                                    / blank_lines
                                    
computation_a_direct_property_line  = indent computation_a_direct_property line_end
computation_a_direct_property       = "itemName" ":" ws string_like_value

computation_a_group_block           = computation_a_execution
                                    / computation_a_computation

computation_a_execution             = indent "execution" ws "{" line_end computation_a_execution_property_line* indent "}" line_end
computation_a_execution_property_line = indent computation_a_execution_property line_end
computation_a_execution_property    = "sequence" ":" ws number
                                    / "point" ":" ws ( "newSession" / "beforeHeader" / "afterHeader" / "beforeRegions" / "afterRegions" / "beforeFooter" / "afterFooter" / "afterSubmit" )

computation_a_computation           = indent "computation" ws "{" line_end computation_a_computation_property_line* indent "}" line_end
computation_a_computation_property_line = indent computation_a_computation_property line_end
computation_a_computation_property  = "type" ":" ws ( "staticValue" / "item" / "sqlQuerySingleValue" / "sqlQueryMultipleValues" / "expression" / "functionBody" / "preference" )
                                    / "staticValue" ":" ws string_like_value
                                    / "sqlQuery" ":" ws code_block
                                    / "computationProcessed" ":" ws ( "newSession" / "replaceExisting" / "addToExisting" / "raiseErrorOnReplace" / "replaceNullValues" )
                                    / "language" ":" ws ( "sql" / "plsql" / "javaScript-mle" )
                                    / "sqlExpression" ":" ws code_block
                                    / "plsqlExpression" ":" ws code_block
                                    / "javaScriptExpression" ":" ws code_block
                                    / "plsqlFunctionBody" ":" ws code_block
                                    / "javaScriptFunctionBody" ":" ws code_block
                                    / "itemName" ":" ws string_like_value
                                    / "preference" ":" ws string_like_value
dynamic_action                      = indent "dynamicAction" (required_ws component_id)? ws "(" line_end dynamic_action_body_line* indent ")" line_end
dynamic_action_body_line            = dynamic_action_direct_property_line
                                    / dynamic_action_group_block
                                    / dynamic_action_child_component
                                    / blank_lines

dynamic_action_direct_property_line = indent dynamic_action_direct_property line_end
dynamic_action_direct_property      = "name" ":" ws string_like_value
                                    / "???" ":" ws string_like_value

dynamic_action_group_block          = dynamic_action_execution
                                    / dynamic_action_when
                                    / dynamic_action_client_side_condition

dynamic_action_execution            =  indent "execution" ws "{" line_end dynamic_action_execution_property_line* indent "}" line_end
dynamic_action_execution_property_line =  indent dynamic_action_execution_property line_end
dynamic_action_execution_property   =  "sequence" ":" ws number
                                    / "eventScope" ":" ws ( "static" / "dynamic" / "once" )
                                    / "staticContainer" ":" ws string_like_value
                                    / "type" ":" ws ( "immediate" / "debounce" / "throttle" )
                                    / "time" ":" ws number
                                    / "immediate" ":" ws boolean

dynamic_action_when                 = indent "when" ws "{" line_end dynamic_action_when_property_line* indent "}" line_end
dynamic_action_when_property_line   = indent dynamic_action_when_property line_end
dynamic_action_when_property        = "event" ":" ws string_like_value
                                    / "customEvent" ":" ws string_like_value
                                    / "selectionType" ":" ws ( "items" / "button" / "region" / "columns" / "domObject" / "jQuerySelector" / "jsExpression" )
                                    / "region" ":" ws reference
                                    / "interactiveGrid" ":" ws reference
                                    / "columns" ":" ws one_or_more_string_like_values
                                    / "button" ":" ws reference
                                    / "items" ":" ws one_or_more_string_like_values
                                    / "domObject" ":" ws string_like_value
                                    / "jquerySelector" ":" ws string_like_value
                                    / "javaScriptExpression" ":" ws code_block

dynamic_action_client_side_condition = indent "clientSideCondition" ws "{" line_end dynamic_action_client_side_condition_property_line* indent "}" line_end
dynamic_action_client_side_condition_property_line = indent dynamic_action_client_side_condition_property line_end
dynamic_action_client_side_condition_property = "type" ":" ws ( "item=value" / "item!=value" / "item>value" / "item>=value" / "item<value" / "item<=value" / "itemIsNull" / "itemIsNotNull" / "itemIsInList" / "itemIsNotInList" / "jsExpression" )
                                    / "item" ":" ws string_like_value
                                    / "value" ":" ws string_like_value
                                    / "list" ":" ws array_of_string_like_value
                                    / "javaScriptExpression" ":" ws code_block
                                    / "type" ":" ws ( "itemColumn=value" / "itemColumn!=value" / "itemColumn>value" / "itemColumn>=value" / "itemColumn<value" / "itemColumn<=value" / "itemColumnIsNull" / "itemColumnIsNotNull" / "itemColumnIsInList" / "itemColumnIsNotInList" / "jsExpression" )
                                    / "componentType" ":" ws ( "item" / "column" )
                                    / "column" ":" ws string_like_value

dynamic_action_child_component      = action_c
action_c                            = indent "action" (required_ws component_id)? ws "(" line_end action_c_body_line* indent ")" line_end
