column_f_appearance_property    = "formatMask" ":" ws string_like_value
                                / "group" ":" ws boolean

column_f_source                 = indent "source" ws "{" line_end column_f_source_property_line* indent "}" line_end
column_f_source_property_line   = indent column_f_source_property line_end
column_f_source_property        = "type" ":" ws ( "databaseColumn" / "sqlExpression" / "none" )
                                / "databaseColumn" ":" ws string_like_value
                                / "sqlExpression" ":" ws code_block
                                / "dataType" ":" ws ( "timestampWithTimeZone" / "timestampWithLocalTimeZone" / "intervalYearToMonth" / "intervalDayToSecond" / "clob" / "blob" / "boolean" / "rowid" / "bfile" / "sdoGeometry" / "varchar2" / "number" / "date" / "timestamp" )
                                / "primaryKey" ":" ws boolean
                                / "availableOnClient" ":" ws boolean
                                / "valueProtected" ":" ws boolean

branch_a               = indent "branch" (required_ws component_id)? ws "(" line_end branch_a_body_line* indent ")" line_end
branch_a_body_line     = branch_a_direct_property_line
                       / branch_a_group_block
                       / blank_lines

branch_a_direct_property_line     = indent branch_a_direct_property line_end 
branch_a_direct_property          = "name" ":" ws string_like_value

branch_a_group_block              = branch_a_execution
                                  / branch_a_behavior

branch_a_execution                      = indent "execution" ws "{" line_end branch_a_execution_property_line* indent "}" line_end
branch_a_execution_property_line        = indent branch_a_execution_property line_end
branch_a_execution_property             = "sequence" ":" ws number
                                        / "point" ":" ws ( "beforeHeader" / "afterSubmit" / "validating" / "processing" / "afterProcessing" )

branch_a_behavior                      = indent "behavior" ws "{" line_end branch_a_behavior_property_line* indent "}" line_end
branch_a_behavior_property_line        = indent branch_a_behavior_property line_end
branch_a_behavior_property             = "type" ":" ws ( "pageOrUrl" / "urlIdentifiedByItem" / "functionReturningUrl" / "page" 
                                       / "pageIdentifiedByItem" / "functionReturningPage" / "plsqlProcedure" / "pageProcessing" )
                                       / "target" ":" ws value
                                       / "saveStateBeforeBranching" ":" ws boolean
                                       / "pageNumber" ":" ws number
                                       / "request" ":" ws string_like_value
                                       / "item" ":" ws string_like_value
                                       / "language" ":" ws ( "plsql" / "javaScript-mle" )
                                       / "plsqlFunctionBody" ":" ws code_block
                                       / "javaScriptFunctionBody" ":" ws code_block
                                       / "plsqlCode" ":" ws code_block
series               = indent "series" (required_ws component_id)? ws "(" line_end series_body_line* indent ")" line_end
series_body_line     = series_direct_property_line
                       / series_group_block
                       #/ series_child_component
                       / blank_lines

series_direct_property_line     = indent series_direct_property line_end 
series_direct_property          = "name" ":" ws string_like_value
                                / "type" ":" ws ( "lineWithArea" / "scatter" / "bubble" / "barRange" / "areaRange" / "boxPlot" / "area" / "bar" / "line" )

series_group_block              = series_execution
                                / series_source
                                / series_column_mapping
                                / series_line

series_execution                      = indent "execution" ws "{" line_end series_execution_property_line* indent "}" line_end
series_execution_property_line        = indent series_execution_property line_end
series_execution_property             = "sequence" ":" ws number

series_source                      = indent "source" ws "{" line_end series_source_property_line* indent "}" line_end
series_source_property_line        = indent series_source_property line_end
series_source_property             = "location" ":" ws ( "localDatabase" / "restEnabledSql" / "restSource" / "jsonDualityView" / "jsonSource" / "regionSource" / "sampleData" )
                                   / "remoteServer" ":" ws reference
                                   / "sampleData" ":" ws ( "employees" / "tasks" / "products" / "projects" )
                                   / "type" ":" ws string_like_value
                                   / "tableOwner" ":" ws string_like_value
                                   / "tableName" ":" ws string_like_value
                                   / "includeRowidColumn" ":" ws boolean 
                                   / "whereClause" ":" ws code_block
                                   / "graphOwner" ":" ws string_like_value
                                   / "graphName" ":" ws string_like_value
                                   / "matchClause" ":" ws code_block
                                   / "columnsClause" ":" ws code_block
                                   / "sqlQuery" ":" ws code_block
                                   / "language" ":" ws ( "plsql" / "javaScript-mle" )
                                   / "plsqlFunctionBody" ":" ws code_block
                                   / "javaScriptFunctionBody" ":" ws code_block
                                   / "restSource" ":" ws reference
                                   / "jsonDualityView" ":" ws reference
                                   / "jsonSource" ":" ws reference
                                   / "pageItemsToSubmit" ":" ws one_or_more_string_like_values
                                   / "optimizerHint" ":" ws string_like_value

series_column_mapping                      = indent "columnMapping" ws "{" line_end series_column_mapping_property_line* indent "}" line_end
series_column_mapping_property_line        = indent series_column_mapping_property line_end
series_column_mapping_property             = "seriesName" ":" ws string_like_value
                                           / "label" ":" ws string_like_value
                                           / "valueAggregation" ":" ws ( "countDistinct" / "count" / "sum" / "average" / "median" / "min" / "max" / "approxCountDistinct" )
                                           / "value" ":" ws string_like_value
                                           / "open" ":" ws string_like_value
                                           / "low" ":" ws string_like_value
                                           / "high" ":" ws string_like_value
                                           / "close" ":" ws string_like_value
                                           / "volume" ":" ws string_like_value
                                           / "x" ":" ws string_like_value
                                           / "y" ":" ws string_like_value
                                           / "z" ":" ws string_like_value
                                           / "targetValue" ":" ws string_like_value
                                           / "minValue" ":" ws string_like_value
                                           / "maxValue" ":" ws string_like_value
                                           / "rowId" ":" ws string_like_value
                                           / "rowName" ":" ws string_like_value
                                           / "taskId" ":" ws string_like_value
                                           / "taskName" ":" ws string_like_value
                                           / "taskStartDate" ":" ws string_like_value
                                           / "taskEndDate" ":" ws string_like_value
                                           / "progress" ":" ws string_like_value
                                           / "baselineStartDate" ":" ws string_like_value
                                           / "baselineEndDate" ":" ws string_like_value
                                           / "customTooltip" ":" ws string_like_value
                                           / "legendTooltip" ":" ws string_like_value
                                           / "labelTooltip" ":" ws string_like_value
                                           / "customColumn" ":" ws string_like_value


series_line                      = indent "line" ws "{" line_end series_line_property_line* indent "}" line_end
series_line_property_line        = indent series_line_property line_end
series_line_property             = "style" ":" ws ( "dotted" / "dashed" / "solid" ) 
                                 / "width" ":" ws number
                                 / "type" ":" ws ( "centeredStepped" / "curved" / "centeredSegmented" / "stepped" / "segmented" / "straight" / "auto" / "none" ) 

# series_child_component          = parameter_k
axis               = indent "axis" (required_ws component_id)? ws "(" line_end axis_body_line* indent ")" line_end
axis_body_line     = axis_direct_property_line
                       / axis_group_block
                       / blank_lines

axis_direct_property_line     = indent axis_direct_property line_end 
axis_direct_property          = "name" ":" ws string_like_value
                              / "showAxis" ":" ws boolean
                              / "title" ":" ws string_like_value

axis_group_block              = axis_value
                              / axis_minor_ticks

axis_value                      = indent "value" ws "{" line_end axis_value_property_line* indent "}" line_end
axis_value_property_line        = indent axis_value_property line_end
axis_value_property             = "min" ":" ws number
                                / "max" ":" ws number
                                / "format" ":" ws ( "dateShort" / "dateMedium" / "dateLong" / "dateFull" / "timeShort" / "timeMedium" / "timeLong" / "timeFull" 
                                  / "datetimeShort" / "datetimeMedium" / "datetimeLong" / "datetimeFull" / "decimal" / "currency" / "percent" )
                                / "decimalPlaces" ":" ws number
                                / "currency" ":" ws string_like_value
                                / "pattern" ":" ws string_like_value
                                / "formatScaling" ":" ws ( "none" / "auto" / "thousand" / "million" / "billion" / "trillion" / "quadrillion" )
                                / "baselineScaling" ":" ws ( "min" / "zero" )
                                / "scale" ":" ws ( "linear" / "log" )
                                / "step" ":" ws number                               

axis_minor_ticks                      = indent "minorTicks" ws "{" line_end axis_minor_ticks_property_line* indent "}" line_end
axis_minor_ticks_property_line        = indent axis_minor_ticks_property line_end
axis_minor_ticks_property             = "show" ":" ws ( "auto" / "true" / "false" )
                                      / "step" ":" ws number

reference                       = "@" reference_character*
variable                        = "&" reference_character "."
special_variable                = ~r"#[^#\n\t\r]+#"
component_id                    = number / identifier / string
code_block                      = nl? ws multiline_string
                                / string_like_value
multiline_string                = "```" ( any_character / nl )* "```"
blank_lines                     = (ws nl)*
ws                              = ~r"[ \t]*"
required_ws                     = ~r"[ \t]+"
line_end                        = nl
nl                              = "\n" / "\r\n"
indent                          = ~r"[ \t]*"
value                           = multiline_string / array / complex / boolean / number / reference / variable / special_variable / string / identifier
array                           = array_of_value
array_separator                 = required_ws / line_end indent
array_of_value                  = "[" ( ws value ( array_separator value )* ws / line_end ( indent value line_end )? indent )? "]"
array_of_number                 = "[" ( ws number ( array_separator number )* ws / line_end ( indent number line_end )? indent )? "]"
array_of_string_like_value      = "[" (line_end indent string_like_value)+ line_end indent "]"
one_or_more_string_like_values  = array_of_string_like_value / string_like_value
complex                         = "{" line_end key_value_line* indent "}"
key_value_line                  = indent key_value line_end
key_value                       = identifier ":" ws value
string_like_value               = ~r"[^\[\]\n\r]+"
reference_character             = ~r"[A-Za-z0-9_/#-]*"
string                          = ~r"\"[^\"]+\""
any_character                   = ~r"[^`\n\r]"
number                          = "-"? digit+  ( "." digit+ )?
digit                           = ~r"[0-9]"
identifier                      = identifier_start identifier_rest*
identifier_start                = ~r"[A-Za-z0-9_]"
identifier_rest                 = identifier_start / "." / "-"
boolean                         = "true" / "false"