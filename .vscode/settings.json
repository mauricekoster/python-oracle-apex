{
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.defaultInterpreterPath": "c:\\ws\\python-oracle-apex\\.venv\\Scripts\\python.exe",
    "robotcode.disableExtension": true,
     "multiCommand.commands": [
      
    { // run this first 
      "command": "multiCommand.replace_ebnf",
      "sequence": [
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "\\(\\*.*\\*\\)", 
            "replaceString": "",
            "isRegex": true,
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "<ws>", 
            "replaceString": "ws",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "^(\\s*)\\|", 
            "replaceString": "/",
            "isRegEx": true
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "<string-like-value>", 
            "replaceString": "string_like_value",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "<array-of-string-like-value>", 
            "replaceString": "array_of_string_like_value",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "<boolean>", 
            "replaceString": "boolean",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "<reference>", 
            "replaceString": "reference",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "<number>", 
            "replaceString": "number",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "<array-of-number>", 
            "replaceString": "array_of_number",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": "<multiline-string>", 
            "replaceString": "code_block",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        {
          "command": "editor.actions.findWithArgs",
          "args": {
            "searchString": " \\| ", 
            "replaceString": " / ",
          }
        },
        { // run this second 
          // replace all matches
          "command": "editor.action.replaceAll"
        },
        { // run this third
          // close search widget 
          "command": "closeFindWidget"
        }
      ],
      "when": "editorTextFocus"
    },
  ]
}